{
  "seed": 42,
  "fixed_parameters": {
    "objective": "binary",
    "n_estimators": 600,
    "learning_rate": 0.05,
    "num_leaves": 31,
    "min_child_samples": 200,
    "reg_lambda": 2.0,
    "verbosity": -1,
    "random_state": 42,
    "n_jobs": 8,
    "deterministic": true,
    "force_col_wise": true
  },
  "primary_outcome": "visit",
  "secondary_outcome": "conversion",
  "class_rebalancing": "none; preserve probability estimation",
  "early_stopping": {
    "rounds": 50,
    "criterion": "validation loss"
  },
  "selection": "validation Qini, only among uplift learners",
  "training_rows": 1800000,
  "validation_rows": 600000
}